# ==============================================================================
# Self-Healing RAG Agent — Backend Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to '.env' and populate your local values.
# NEVER commit real production secrets, credentials, or API keys to git.
# ==============================================================================

# Application Metadata & Runtime
APP_ENV=development
APP_NAME=self-healing-rag-agent
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database (Asyncpg driver + pgvector support)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/self_healing_rag
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0

# Redis Cache & Distributed State
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_SOCKET_TIMEOUT=5.0
REDIS_MAX_CONNECTIONS=20

# Security & Authentication (Phase 3)
JWT_SECRET=replace-with-a-secure-random-64-character-hex-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Development Demo Quick Access (Local development ONLY; MUST remain false in production)
DEMO_LOGIN_ENABLED=false
VITE_DEMO_LOGIN_ENABLED=false

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# LLM Providers (Groq API Primary Production Provider)
# Supported options: groq (recommended default), openai, synthesis
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=30.0
LLM_TEMPERATURE=0.0

# Embedding Providers (Phase 4 Foundation)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# Knowledge Base & Document Ingestion (Phase 4)
MAX_UPLOAD_SIZE_MB=50
ALLOWED_DOCUMENT_TYPES=pdf,docx,txt,md,csv
CHUNK_SIZE=500
CHUNK_OVERLAP=50
INGESTION_MAX_RETRIES=3

# Document Storage (Phase 4)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=data/storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=self-healing-rag
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Retrieval & Reranker Engine (Phase 5)
RETRIEVAL_DEFAULT_MODE=hybrid
RETRIEVAL_CANDIDATE_LIMIT=20
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.0
RETRIEVAL_RRF_K=60
RETRIEVAL_ENABLE_RERANKING=true
RERANKER_PROVIDER=flashrank
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
RERANKER_MAX_CANDIDATES=20

# Observability & Production Intelligence (Phase 10 & 11)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=self-healing-rag-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=self-healing-rag
