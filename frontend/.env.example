# ==============================================================================
# Self-Healing RAG Agent — Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the frontend/ folder if overriding default proxy.
# ==============================================================================

# Backend API Base URL (defaults to /api/v1 via Vite development proxy)
VITE_API_URL=/api/v1

# Development Demo Quick Access (Enable demo single-click login for local tests)
VITE_DEMO_LOGIN_ENABLED=false
